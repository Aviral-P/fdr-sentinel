# Default local fallback when PostgreSQL is not running.
DATABASE_URL=sqlite:///./fdr_sentinel.db

# For a local PostgreSQL server, replace DATABASE_URL with a local DSN, e.g.:
# DATABASE_URL=postgresql+psycopg://fdr_sentinel:replace_me@localhost:5432/fdr_sentinel

APP_NAME=FDR Sentinel API
API_V1_PREFIX=/api/v1
DEBUG=false
APP_ENV=development
JWT_SECRET_KEY=replace_with_a_random_local_secret_of_at_least_32_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=fdr-sentinel-local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_DIR=./backend/data/documents
MAX_DOCUMENT_SIZE_BYTES=15728640
MATURITY_REMINDER_WINDOWS_DAYS=30,15,7
ACTION_OVERDUE_DAYS=7
